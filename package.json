{
  "name": "msm",
  "productName": "MSM for YouTube",
  "version": "0.1.10",
  "description": "A desktop YouTube app for Windows with a built-in AI-content filter, plus the same filter as a browser extension.",
  "author": "blunthex1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "homepage": "https://github.com/blunthex1/msm",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"test/*.test.js\"",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1"
  },
  "build": {
    "appId": "io.github.blunthex1.msm",
    "productName": "MSM for YouTube",
    "executableName": "MSM",
    "directories": {
      "output": "release",
      "buildResources": "app/build"
    },
    "files": [
      "package.json",
      "app/main.js",
      "app/updater.js",
      "app/dist/**",
      "app/build/icon.png",
      "core/**/*.js",
      "!core/options/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MSM for YouTube",
      "artifactName": "MSM-for-YouTube-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MSM-for-YouTube-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blunthex1",
        "repo": "msm",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-updater": "^6.8.9"
  }
}
